{
    "folders": [
        {
            "name": "▲",
            "path": "."
        },
        {
            "name": "🖥️ apps/api",
            "path": "apps/api"
        },
        {
            "name": "📲 apps/editor",
            "path": "apps/editor"
        },
        {
            "name": "📲 apps/sidecar",
            "path": "apps/sidecar"
        },
        {
            "name": "📦 packages/core",
            "path": "packages/core"
        },
    ],
    "settings": {
        "licenser.author": "ACT UP New York <info@actupny.com>",
        "licenser.projectName": "ACT UP Oral History Project",
        "licenser.license": "AGPLv3",
        "editor.tabSize": 4,
        "files.exclude": {
            "**/node_modules": true,
            "**/target": true,
            "**/cache": true,
            "**/.remember": true,
            "**/.turbo": true,
            "**/.tanstack": true,
            "**/.pnpm-store": true
        },
        "files.watcherExclude": {
            "**/node_modules": true,
            "**/target": true,
            "**/cache": true,
            "**/assets": true,
            "**/.remember": true,
            "**/routeTree.gen.ts": true
        },
        "files.readonlyInclude": {
            "**/routeTree.gen.ts": true
        },
        "search.exclude": {
            "**/routeTree.gen.ts": true
        },
        "eslint.enable": false,
        "[rust]": {
            "editor.defaultFormatter": "rust-lang.rust-analyzer",
            "editor.formatOnSave": true
        },
        "[scss]": {
            "editor.codeActionsOnSave": {
                "source.fixAll.stylelint": "always"
            }
        },
        "stylelint.enable": true,
        "stylelint.validate": [
            "javascript",
            "typescript",
            "javascriptreact",
            "typescriptreact",
        ],
        "oxc.enable.oxlint": true,
        "oxc.enable.oxfmt": false,
        "oxc.fixKind": "all",
        "oxc.requireConfig": true,
        "licenser.useSingleLineStyle": false,
        "rust-analyzer.files.exclude": [
            "./target"
        ],
        "[typescriptreact]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        },
        "[javascriptreact]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        },
        "[javascript]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        },
        "[typescript]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        }
    }
}
