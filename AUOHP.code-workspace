{
    "folders": [
        {
            "name": "▲  auohp",
            "path": "."
        },
        {
            "name": "💿 @auohp/core",
            "path": "packages/core"
        },
        {
            "name": "🌐 @auohp/api",
            "path": "packages/api"
        },
        {
            "name": "🖥️ @auohp/desktop",
            "path": "packages/desktop"
        },
        {
            "name": "✏️ @auohp/editor",
            "path": "packages/editor"
        },
        {
            "name": "🕵️ @auohp/search-component",
            "path": "packages/search-component"
        },
        {
            "name": "⚙️ @auohp/scripts",
            "path": "packages/scripts"
        }
    ],
    "settings": {
        "licenser.author": "ACT UP New York <contact@actupny.com>",
        "licenser.projectName": "ACT UP Oral History Project",
        "licenser.license": "AGPLv3",
        "editor.tabSize": 4,
        "files.exclude": {
            "**/node_modules": true,
            "**/.yarn": true,
            "**/target": true
        },
        "search.exclude": {
            "**/assets/**": true,
            "**/gql/**": true
        },
        "files.watcherExclude": {
            "**/node_modules/**": true,
            "**/.yarn/**": true,
            "**/target/**": true,
            "**/assets/**": true
        },
        "eslint.enable": false,
        "[rust]": {
            "editor.defaultFormatter": "rust-lang.rust-analyzer",
            "editor.formatOnSave": true
        },
        "[scss]": {
            "editor.codeActionsOnSave": {
                "source.fixAll.stylelint": "always"
            }
        },
        "stylelint.enable": true,
        "stylelint.validate": [
            "javascript",
            "typescript",
            "javascriptreact",
            "typescriptreact"
        ],
        "oxc.enable.oxlint": true,
        "js/ts.experimental.useTsgo": true,
        "licenser.useSingleLineStyle": false,
        "rust-analyzer.files.exclude": [
            "**/node_modules/**",
            "**/.yarn/**",
            "**/target/**",
            "**/assets/**"
        ],
        "[typescriptreact]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        },
        "[javascriptreact]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        },
        "[javascript]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        },
        "[typescript]": {
            "editor.formatOnSave": false,
            "editor.defaultFormatter": "oxc.oxc-vscode",
            "editor.codeActionsOnSave": [
                "source.fixAll.stylelint",
                "source.fixAll.oxc"
            ],
        }
    }
}
