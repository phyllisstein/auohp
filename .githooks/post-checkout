#!/bin/sh
# Chain to Git LFS's own post-checkout behavior first, since this hook
# replaces whatever core.hooksPath pointed at before (normally the
# LFS-managed .git/hooks/post-checkout).
if command -v git-lfs >/dev/null 2>&1; then
	git lfs post-checkout "$@"
fi

# Only act on worktrees, not the main checkout or a plain branch switch.
# GIT_DIR and GIT_COMMON_DIR coincide in the main checkout; they diverge
# for any worktree (GIT_DIR points at .git/worktrees/<name>, while
# GIT_COMMON_DIR always points at the real, shared .git).
git_dir="$(git rev-parse --git-dir)"
common_dir="$(git rev-parse --git-common-dir)"

if [ "$git_dir" = "$common_dir" ]; then
	exit 0
fi

repo_root="$(cd "$(dirname "$common_dir")" && pwd)"
worktree_root="$(git rev-parse --show-toplevel)"
branch_name="$(basename "$worktree_root")"

# Copy untracked env files the project needs to run --- they're gitignored,
# so a fresh worktree checkout never has them.
for f in .env .envrc; do
	if [ -f "$repo_root/$f" ] && [ ! -e "$worktree_root/$f" ]; then
		cp "$repo_root/$f" "$worktree_root/$f"
	fi
done

# Prepend a back-pointer to the worktree's CLAUDE.md so a fresh session
# immediately knows it's a satellite of the main repo, not the primary
# checkout, without needing a shared (and write-contended) memory directory.
claude_md="$worktree_root/CLAUDE.md"
marker="# Worktree of $(basename "$repo_root")"
if [ -f "$claude_md" ] && ! grep -qF "$marker" "$claude_md" 2>/dev/null; then
	tmp="$(mktemp)"
	{
		printf '%s\n\n' "$marker"
		printf 'This directory is a git worktree of the main repo at\n'
		printf '`%s` (branch `%s`, created %s).\n' "$repo_root" "$branch_name" "$(date +%Y-%m-%d)"
		printf 'It is NOT the primary checkout. Project conventions, architecture notes,\n'
		printf "and collaboration style live in that repo's CLAUDE.md --- read it for full\n"
		printf 'context if this file alone seems insufficient.\n\n---\n\n'
		cat "$claude_md"
	} > "$tmp"
	mv "$tmp" "$claude_md"
fi

# Rename the VS Code multi-root workspace file so this worktree gets its
# own distinguishable entry in VS Code's window title and recent-workspaces
# picker. Folder `path` entries inside it are relative to the file's own
# location, so they still resolve correctly unmodified.
for ws in "$repo_root"/*.code-workspace; do
	[ -e "$ws" ] || continue
	base="$(basename "$ws" .code-workspace)"
	dest="$worktree_root/$base-$branch_name.code-workspace"
	if [ ! -e "$dest" ]; then
		cp "$ws" "$dest"
	fi
	stray="$worktree_root/$(basename "$ws")"
	if [ -e "$stray" ] && [ "$stray" != "$dest" ]; then
		rm -f "$stray"
	fi
done
