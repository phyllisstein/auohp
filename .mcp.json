{
  "mcpServers": {
    "neo4j-mcp": {
      "type": "stdio",
      "command": "neo4j-mcp",
      "args": [],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "auohpauohp",
        "NEO4J_DATABASE": "neo4j",
        "NEO4J_READ_ONLY": "false",
        "NEO4J_TELEMETRY": "false",
        "NEO4J_LOG_LEVEL": "info",
        "NEO4J_LOG_FORMAT": "text",
        "NEO4J_SCHEMA_SAMPLE_SIZE": "100"
      }
    },
    "neo4j-data-modeling": {
      "command": "uvx",
      "args": [
        "mcp-neo4j-data-modeling@0.8.2",
        "--transport",
        "stdio"
      ]
    },
    "neo4j-database": {
      "command": "uvx",
      "args": [
        "mcp-neo4j-cypher@0.5.3",
        "--transport",
        "stdio"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "auohpauohp",
        "NEO4J_DATABASE": "neo4j"
      }
    }
  }
}
