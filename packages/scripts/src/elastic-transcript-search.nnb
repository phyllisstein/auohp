            "source": [
                "import { Client } from '@elastic/elasticsearch'\n\nconst esClient = new Client({\n    node: 'https://elastic.auohp.here',\n    tls: {\n        rejectUnauthorized: false\n    },\n})\n\nawait esClient.ping()\n\nconst result = await esClient.search(\n    {\n        index: 'transcripts',\n        highlight: {\n            fields: {\n                text: {},\n            },\n            pre_tags: '{{',\n            post_tags: '}}',\n        },\n        query: {\n            match: {\n                text: \"gmhc\",\n            },\n        },\n    }\n)\n\nconst hitsAndScores = result.hits.hits.map((hit) => ({\n    score: hit._score,\n    text: hit.highlight?.text?.join(''),\n}))\n\nhitsAndScores.sort((a, b) => b.score - a.score)"
            ],
            "outputs": [
                {
                    "items": [
                        {
