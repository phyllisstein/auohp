                "import neo4j from 'neo4j-driver'\n\nconst driver = neo4j.driver(\n    'bolt://localhost:7687',\n    neo4j.auth.basic('neo4j', 'auohpauohp'),\n    {\n        disableLosslessIntegers: true,\n    }\n)\n\nconst result = await driver.executeQuery(`\n    CALL db.index.fulltext.queryNodes('transcript_search', 'gmhc') YIELD node, score\n    RETURN node, score\n`)\n\nconst hitsAndScores = result.records.map((record) => ({\n    score: record.get('score'),\n    text: record.get('node').properties.text,\n}))\n\nhitsAndScores.sort((a, b) => b.score - a.score)"
            ],
