{
    "compileOnSave": false,
    "compilerOptions": {
        "baseUrl": "./",
        "outDir": "./dist",
        "jsx": "preserve",
        "paths": {
            "*": [
                "src/*",
                "vendor/*",
                "node_modules/*",
                "*"
            ]
        },
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "module": "es2020",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2020",
        "incremental": true,
        "skipLibCheck": true,
        "moduleResolution": "node"
    },
    "include": [
        "./lib/**/*.ts",
        "./lib/**/*.tsx",
        "./lib/**/*.d.ts",
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "./src/**/*.d.ts",
        "./vendor/**/*.ts",
        "./vendor/**/*.tsx",
        "./vendor/**/*.d.ts",
        "./next-env.d.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "plugins": [
        {
            "name": "typescript-styled-plugin",
            "validate": false
        }
    ]
}
