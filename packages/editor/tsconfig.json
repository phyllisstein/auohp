{
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist",
        "jsx": "react-jsx",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "noImplicitAny": false,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "module": "esnext",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "esnext",
        "incremental": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "checkJs": false,
        "plugins": [
            {
                "name": "@0no-co/graphqlsp",
                "schema": "./schema.graphql"
            }
        ]
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "./src/**/*.d.ts",
        "*.js",
        "*.ts",
        "*.tsx"
    ],
    "exclude": [
        "node_modules"
    ],
    "typeAcquisition": {
        "enable": true
    }
}
