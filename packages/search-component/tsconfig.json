{
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist",
        "jsx": "react-jsx",
        "paths": {
            "*": [
                "./src/*",
                "./vendor/*"
            ]
        },
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "module": "esnext",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "esnext",
        "incremental": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "checkJs": false
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "./src/**/*.d.ts",
        "./vite-env.d.ts",
        "*.js",
        "*.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "typeAcquisition": {
        "enable": true
    }
}
