[
    "trigger",
    "/app",
    {
        "name": "editor-restart",
        "expression": [
            "allof",
            [
                "not",
                [
                    "match",
                    "**/node_modules/**",
                    "wholename"
                ]
            ],
            [
                "dirname",
                "apps/editor"
            ],
            [
                "name",
                [
                    ".env",
                    "tsconfig.json",
                    "vite.config.ts"
                ]
            ]
        ],
        "command": [
            "/app/scripts/watchman/develop.sh",
            "editor"
        ],
        "append_files": false
    }
]
