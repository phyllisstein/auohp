[
    "trigger",
    "/app",
    {
        "name": "editor-restart",
        "expression": [
            "allof",
            ["dirname", "packages/editor"],
            ["name",
                [
                    ".env",
                    "tsconfig.json",
                    "vite.config.ts"
                ]
            ]
        ],
        "command": [
            "/app/scripts/develop.sh",
            "editor"
        ],
        "append_files": false
    }
]
