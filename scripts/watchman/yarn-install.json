[
    "trigger",
    "/app",
    {
        "name": "yarn-install",
        "expression": [
            "allof",
            ["not", ["match", "**/node_modules/**", "wholename"]],
            ["name",
                [
                    "yarn.lock",
                    ".yarnrc.yml"
                ]
            ]
        ],
        "command": [
            "/app/scripts/develop.sh",
            "yarn"
        ],
        "append_files": false
    }
]
