[
    "trigger",
    "/app",
    {
        "name": "api-restart",
        "expression": [
            "allof",
            ["not", ["match", "**/node_modules/**", "wholename"]],
            ["anyof",
                ["dirname", "packages/api"],
                ["dirname", "packages/core"]
            ],
            ["anyof",
                ["match", "*.rs"],
                ["name",
                    [
                        ".env",
                        "Cargo.toml",
                        "Cargo.lock"
                    ]
                ]
            ]
        ],
        "command": [
            "/app/scripts/develop.sh",
            "api"
        ],
        "append_files": false
    }
]
