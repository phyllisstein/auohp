[
    "trigger",
    "/app",
    {
        "name": "api-restart",
        "expression": [
            "allof",
            [
                "anyof",
                [
                    "dirname",
                    "apps/api"
                ],
                [
                    "dirname",
                    "packages/core"
                ]
            ],
            [
                "anyof",
                [
                    "match",
                    "*.rs"
                ],
                [
                    "name",
                    [
                        ".env",
                        "Cargo.toml",
                        "Cargo.lock"
                    ]
                ]
            ]
        ],
        "command": [
            "/app/scripts/watchman/develop.sh",
            "api"
        ],
        "append_files": false
    }
]
